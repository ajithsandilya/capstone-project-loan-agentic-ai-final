# Anthropic API key — required for real LLM mode
ANTHROPIC_API_KEY="sk-nJGrKbiO49ImynAgTBxyeQ"

# Claude model name — set to Claude Sonnet 4.6 model identifier
ANTHROPIC_MODEL_NAME=global.anthropic.claude-sonnet-4-6

# Gateway endpoint (SDK appends /v1/messages automatically)
ANTHROPIC_BASE_URL=https://llmgw-wp.tekstac.com

# Set to "true" to use mock LLM mode (no API key required)
MOCK_LLM_MODE=false

# FastAPI microservice URL (used by Streamlit)
FASTAPI_URL=http://localhost:8000


# MCP server ports
MCP_APPLICANT_DB_PORT=8001
MCP_RISK_RULES_DB_PORT=8002
MCP_DECISION_SYNTHESIS_PORT=8003
MCP_NOTIFICATION_SYSTEM_PORT=8004
